# Токен бота от @BotFather (обязательно)
BOT_TOKEN=
# Твой Telegram id (узнать: /id в боте). Без него бот открыт для всех, нет /stats и оповещений
ADMIN_ID=
# 1 — бот для всех без запроса доступа
PUBLIC=
# OAuth-токен Яндекс Музыки (необязательно: без него поиск через YouTube Music и SoundCloud)
YANDEX_TOKEN=
# Где хранить базу (кэш, пользователи, статистика)
DB_PATH=data/bot.db
# Сколько треков качать одновременно (1 — под 256 МБ RAM; 2 — от ~400 МБ). Остальные ждут в очереди
MAX_PARALLEL=1
# Сколько треков один человек может держать в очереди
MAX_PER_USER=30
# Прокси только для скачивания с YouTube, например socks5://127.0.0.1:40000
YT_PROXY=
