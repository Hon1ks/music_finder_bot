# Токен бота от @BotFather (обязательно)
BOT_TOKEN=
# OAuth-токен Яндекс Музыки (необязательно: без него бот ищет только на YouTube)
YANDEX_TOKEN=
# Сколько треков качать одновременно (1 — под 256 МБ RAM; 2 — от ~400 МБ). Остальные ждут в очереди
MAX_PARALLEL=1
# Прокси только для скачивания с YouTube (YouTube блокирует IP серверов), например socks5://127.0.0.1:40000
YT_PROXY=
